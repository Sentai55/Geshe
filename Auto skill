-- 1. AUTO-CLEAN GUI LAMA
local CoreGui = game:GetService("CoreGui")
local oldGui = CoreGui:FindFirstChild("DeltaCustomToggle")
if oldGui then oldGui:Destroy() end

-- 2. PENGECEKAN PLACE ID
local TARGET_OFF_PLACE_ID = 117533937949084
local isLooping = (game.PlaceId ~= TARGET_OFF_PLACE_ID)

-- 3. MEMBUAT INSTANCE GUI (40x40 di tengah layar)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DeltaCustomToggle"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

local button = Instance.new("TextButton")
button.Parent = ScreenGui
button.Size = UDim2.new(0, 40, 0, 40)
button.AnchorPoint = Vector2.new(0.5, 0.5) 
button.Position = UDim2.new(0.5, 0, 0.5, 0)
button.Text = isLooping and "ON" or "OFF"
button.BackgroundColor3 = isLooping and Color3.fromRGB(65, 255, 65) or Color3.fromRGB(255, 65, 65)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.SourceSansBold
button.TextSize = 14
button.Active = true

-- 4. LOGIKA DRAGGABLE
local UserInputService = game:GetService("UserInputService")
local dragging, dragInput, dragStart, startPos
local function update(input)
	local delta = input.Position - dragStart
	button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true; dragStart = input.Position; startPos = button.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
	end
end)
button.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then update(input) end end)

-- 5. REMOTES
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Framework = ReplicatedStorage:WaitForChild("Framework", 5)
if not Framework then button.Text = "ERR" return end

local EquipmentRE = Framework:WaitForChild("Gameplay"):WaitForChild("EquipmentSystem"):WaitForChild("EquipmentRE")
local RedPointRemote = Framework:WaitForChild("Systems"):WaitForChild("RedPointSystem"):WaitForChild("RedPointUtil"):WaitForChild("RemoteEvent")
local PlayerActionRE = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PlayerActionRE")

-- ====================================================================
-- 6. SYSTEM SAVING KE FILE DEVICE (JSON CACHE)
-- ====================================================================
local HttpService = game:GetService("HttpService")
local fileName = "senjata_cache.json"

local daftar_id = {}
local id_set = {}

-- Load ID dari file jika file-nya ada di device
if isfile and isfile(fileName) then
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)
    if success and type(decoded) == "table" then
        daftar_id = decoded
        for _, id in ipairs(daftar_id) do
            id_set[id] = true
        end
        print("[AUTO-LOAD] Berhasil memuat " .. #daftar_id .. " ID Senjata dari simpanan device!")
    end
end

-- Fungsi simpan ID baru ke file device
local function addAndSaveID(id)
    if id and not id_set[id] then
        id_set[id] = true
        table.insert(daftar_id, id)
        if writefile then
            writefile(fileName, HttpService:JSONEncode(daftar_id))
        end
        print("[AUTO-SAVE] ID Baru Tersimpan ke Device:", id, "| Total:", #daftar_id)
    end
end

-- Scan ScrollingFrame di Lobby jika ada
task.spawn(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local scroll = LocalPlayer:FindFirstChild("PlayerGui")
		and LocalPlayer.PlayerGui:FindFirstChild("MainGui")
		and LocalPlayer.PlayerGui.MainGui:FindFirstChild("ScreenBackpack")
		and LocalPlayer.PlayerGui.MainGui.ScreenBackpack:FindFirstChild("InventoryFrame")
		and LocalPlayer.PlayerGui.MainGui.ScreenBackpack.InventoryFrame:FindFirstChild("EquipmentContent")
		and LocalPlayer.PlayerGui.MainGui.ScreenBackpack.InventoryFrame.EquipmentContent:FindFirstChild("ScrollingFrame")
	
	if scroll then
		for _, child in ipairs(scroll:GetChildren()) do
			if not child:IsA("UIGridLayout") and not child:IsA("LocalScript") and not child:IsA("UIListLayout") then
				addAndSaveID(child.Name)
			end
		end
	end
end)

-- Hook listener untuk menangkap ID baru di mana saja
local oldFireServer
oldFireServer = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if self == RedPointRemote and (method == "FireServer" or method == "fireServer") then
        if args[1] == "Clear" and args[2] == "Weapon" and args[3] then
            addAndSaveID(tostring(args[3]))
        end
    end
    return oldFireServer(self, ...)
end)

local skills = {"Skill1", "Skill2", "SkillAW"}
local numbers = {1, 2, 3, 4, 5}

-- 7. DUAL LOOP AUTOMATIS
local function startLoops()
	-- LOOP 1: AUTO EQUIP
	task.spawn(function()
		while isLooping do
			if #daftar_id > 0 then
				for i = 1, #daftar_id do
					if not isLooping then break end
					EquipmentRE:FireServer("Equip", daftar_id[i], "Weapon")
					task.wait(0.01)
				end
			else
				task.wait(0.2)
			end
		end
	end)
	
	-- LOOP 2: AUTO SKILL ACTION
	task.spawn(function()
		while isLooping do
			for _, skillName in ipairs(skills) do
				for _, num in ipairs(numbers) do
					if not isLooping then break end
					PlayerActionRE:FireServer("SkillAction", skillName, num)
					task.wait(0.01)
				end
				if not isLooping then break end
			end
		end
	end)
end

-- Jalankan loop hanya jika kondisi awal isLooping == true
if isLooping then
	startLoops()
end

-- Toggle Button ON / OFF
button.MouseButton1Click:Connect(function()
	isLooping = not isLooping
	if isLooping then
		button.Text = "ON"
		button.BackgroundColor3 = Color3.fromRGB(65, 255, 65)
		startLoops()
	else
		button.Text = "OFF"
		button.BackgroundColor3 = Color3.fromRGB(255, 65, 65)
	end
end)
