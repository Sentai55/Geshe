-- 6. LOGIKA EKSEKUSI (LANGSUNG AKTIF DEFAULT)
local isLooping = true

local function startLoops()
	-- LOOP 1: AUTO EQUIP WEAPON (35 SENJATA)
	task.spawn(function()
		while isLooping do
			for i = 1, #daftar_id do
				if not isLooping then break end
				EquipmentRE:FireServer("Equip", daftar_id[i], "Weapon")
				task.wait(0.01)
			end
		end
	end)
	
	-- LOOP 2: AUTO SKILL ACTION
	task.spawn(function()
		while isLooping do
			for _, skillName in ipairs(skills) do
				for _, num in ipairs(numbers) do
					if not isLooping then break end
					PlayerActionRE:FireServer("SkillAction", skillName, num)
					task.wait(0.01)
				end
				if not isLooping then break end
			end
		end
	end)
end

